# ─────────────────────────────────────────────────────────
# PracHub Server — Variables de Entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ─────────────────────────────────────────────────────────

# Servidor
PORT=4000
NODE_ENV=development          # development | production | test

# URLs de la aplicación
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173   # URL base para links en emails

# Autenticación JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Base de Datos (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prachub
DB_USER=root
DB_PASSWORD=

# ── Correo (SMTP) ─────────────────────────────────────────
# En NODE_ENV=development se usa Ethereal automáticamente
# (no se requieren estas vars). Solo obligatorias en producción.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false             # true para puerto 465
SMTP_USER=tu-correo@example.com
SMTP_PASS=tu-contrasena-smtp
SMTP_FROM="PracHub <noreply@prachub.pe>"

# ── IA (Google Gemini) ────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Seguridad Admin ───────────────────────────────────────
# Clave de doble verificación para el login de administrador.
# Debe coincidir con VITE_ADMIN_PORTAL_KEY en el cliente.
ADMIN_ACCESS_SECRET=change-this-admin-secret-in-production
ADMIN_ALERT_EMAIL=admin@prachub.pe
ADMIN_SEED_EMAIL=admin@prachub.pe
ADMIN_SEED_PASSWORD=ChangeThisPassword123!

# ── Logging ───────────────────────────────────────────────
# Nivel de log de Winston: error | warn | info | debug
LOG_LEVEL=info

# ── (Opcional) Redis — para BullMQ y rate-limit distribuido ─
# Solo requerido si se habilitan las colas asíncronas (Punto 3 del plan).
# REDIS_URL=redis://localhost:6379
